<div class="mb-3">
  <label class="form-label" for="capacity">Capacity</label>
  <input
    class="form-control"
    type="number"
    id="capacity"
    name="capacity"
    value="<%= syringe.capacity %>"
    required
  />
</div>

<div class="mb-3">
  <label class="form-label" for="name">Name</label>
  <input
    class="form-control"
    type="text"
    id="name"
    name="name"
    value="<%= syringe.name %>"
    required
  />
</div>

<div class="mb-3">
  <label class="form-label" for="size">Size</label>
  <input
    class="form-control"
    type="text"
    id="size"
    name="size"
    value="<%= syringe.size %>"
    required
  />
</div>

<div class="mb-3">
  <label class="form-label" for="description">Description</label>
  <textarea class="form-control" id="description" name="description" rows="4">
<%= syringe.description || '' %></textarea
  >
</div>
