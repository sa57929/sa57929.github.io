{% extends 'base.html.twig' %}

{% block title %}Syringe{% endblock %}

{% block body %}
    <section class="app-header">
        <h1 class="mb-1">Syringe details</h1>
        <p class="text-muted mb-0">Szczegóły wybranej encji.</p>
    </section>

    <div class="card app-card">
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ syringe.id }}</td>
                    </tr>
                    <tr>
                        <th>Capacity</th>
                        <td>{{ syringe.capacity }}</td>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>{{ syringe.name }}</td>
                    </tr>
                    <tr>
                        <th>Size</th>
                        <td>{{ syringe.size }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ syringe.description }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_syringe_index') }}">back to list</a>
                <a class="btn btn-primary" href="{{ path('app_syringe_edit', {'id': syringe.id}) }}">edit</a>
                {{ include('syringe/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}