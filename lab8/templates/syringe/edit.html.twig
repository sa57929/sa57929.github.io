{% extends 'base.html.twig' %}

{% block title %}Edit Syringe{% endblock %}

{% block body %}
    <section class="app-header">
        <h1 class="mb-1">Edit Syringe</h1>
        <p class="text-muted mb-0">Edycja istniejącego rekordu.</p>
    </section>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card app-card">
                <div class="card-body">
                    {{ include('syringe/_form.html.twig', {'button_label': 'Update'}) }}

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a class="btn btn-outline-secondary" href="{{ path('app_syringe_index') }}">back to list</a>
                        {{ include('syringe/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}